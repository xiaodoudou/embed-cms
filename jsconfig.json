{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "paths": {
      "@s/*": ["./src/services/*"],
      "@c/*": ["./src/components/*"],
      "@f/*": ["./src/filters/*"],
      "@u/*": ["./src/utils/*"],
      "@m/*": ["./src/mixins/*"],
      "@a/*": ["./src/assets/*"],
      "@p/*": ["./src/plugins/*"]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "**/*.js",
    "**/*.d.ts",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
