# The settings of this deployment. scripts/env.sh copies this file to .env and fills the empty secrets with random values.
# .env is read by compose.yaml (env_file, and the ${...} in it): one NAME=value per line, no quotes, no spaces around the =.
# .env is never committed and never copied into the image (.gitignore and .dockerignore both leave it out).

# --- Secrets -------------------------------------------------------------------------------------------------------------

# Sign the login token and the cookie of the session. Random, at least 32 characters, and different from each other.
# Changing one signs everybody out.
AUTH_SECRET=
SESSION_SECRET=

# The first administrator, made when the container starts and nobody has that name. Production has no built-in localAdmin.
# The password is at least 12 characters. It is only used to make the account: change it in the admin afterwards, and you
# can take ADMIN_PASSWORD out of this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Not secret ----------------------------------------------------------------------------------------------------------

# The port of the machine on which the CMS is published, on this machine only (127.0.0.1): a reverse proxy that does the
# https is what the visitors reach.
HOST_PORT=3000

# error, warn, info, verbose, debug or silent
LOG_LEVEL=info

# The name of the image and of the container, and the tag that the scripts build and run
IMAGE=embed-cms-docker
TAG=latest
