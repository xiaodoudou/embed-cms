{
  "name": "embed-cms",
  "version": "3.0.1",
  "description": "Content management system, written in node.js, uses leveldb as an asset and content store.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "server.js",
    "import.js",
    "importFromRemote.js",
    "lib/",
    "lib-import/",
    "lib-importFromRemote/",
    "src/",
    "public/",
    "dist/",
    "i18n/",
    "types/",
    "scripts/",
    "vite.config.js",
    "vite.utils.js",
    "jsconfig.json"
  ],
  "scripts": {
    "dev": "del-cli --force ./src/plugins && cross-env VITE_CJS_IGNORE_WARNING=true vite",
    "build": "vite build --emptyOutDir",
    "prepare": "node scripts/prepare.js",
    "prepack": "npm run build",
    "preview": "vite preview",
    "serve-prod": "cross-env NODE_ENV=production node server.js",
    "serve-backend": "cross-env VITE_DEV_MODE=true node --inspect --no-deprecation server.js",
    "lint": "eslint --fix lib src",
    "knip": "knip",
    "knip-lint": "knip && npm run lint",
    "test": "node --no-deprecation test/server.js",
    "test:unit": "mocha test/unit test/security",
    "unit": "mocha -w test/unit test/security",
    "mongodb": "ulimit -n 1000 && mongod --ipv6 --dbpath=../embed-cms-mongodb-data",
    "mongodb-auth": "ulimit -n 1000 && mongod --tlsMode requireTLS --tlsCertificateKeyFile ./ssl/server.pem --tlsCAFile ./ssl/ca.pem --bind_ip localhost --dbpath=../embed-cms-mongodb-data",
    "test:frontend": "vitest run",
    "test:all": "npm run test:unit && npm run test:frontend && npm test",
    "test:coverage": "c8 mocha test/unit test/security",
    "bench:stores": "node --expose-gc test/bench/stores.js",
    "bench:stores:crash": "node test/bench/stores.js --crash",
    "migrate-store": "node scripts/migrate-store.js"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodoudou/embed-cms.git"
  },
  "bugs": {
    "url": "https://github.com/xiaodoudou/embed-cms/issues"
  },
  "homepage": "https://github.com/xiaodoudou/embed-cms#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cms",
    "node.js",
    "express",
    "leveldb",
    "mongodb"
  ],
  "pkg": {
    "assets": [
      "src/**/*"
    ]
  },
  "bin": {
    "cms": "server.js",
    "cms-import": "import.js",
    "cms-import-remote": "importFromRemote.js"
  },
  "author": "Edouard Durand",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@json-editor/json-editor": "^2.10.1",
    "@mdi/js": "^7.4.47",
    "@tiptap/core": "^3.16.0",
    "@tiptap/extension-code-block": "^3.16.0",
    "@tiptap/extension-code-block-lowlight": "^3.16.0",
    "@tiptap/extension-superscript": "^3.16.0",
    "@tiptap/pm": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "@tiptap/vue-3": "^3.16.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "abstract-level": "^3.1.1",
    "ali-oss": "^6.23.0",
    "ansi-html": "0.0.9",
    "basic-auth-connect": "^1.0.0",
    "body-parser": "^1.20.2",
    "classic-level": "^3.0.0",
    "cli-progress": "^3.12.0",
    "codemirror": "^5.65.20",
    "codemirror-editor-vue3": "^2.8.0",
    "commander": "^2.20.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.4.16",
    "excel4node": "^1.8.0",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "file-type": "^22.1.1",
    "filesize": "^11.0.13",
    "flat": "^6.0.1",
    "fs-extra": "^11.4.1",
    "fuzzysort": "^4.0.2",
    "google-auth-library": "^11.1.0",
    "google-spreadsheet": "^5.3.0",
    "helmet": "^4.2.0",
    "highlight.js": "^11.12.0",
    "json5": "^2.2.3",
    "JSONStream": "^1.3.5",
    "jsonwebtoken": "^9.0.0",
    "level-read-stream": "^2.0.0",
    "lodash": "^4.17.21",
    "lowlight": "^3.3.0",
    "md5-file": "^5.0.0",
    "mime-types": "^3.0.1",
    "mongodb": "^4.12.1",
    "msgpack-stream": "^0.0.13",
    "multer": "^2.1.1",
    "mustache": "^4.2.0",
    "node-os-utils": "^3.1.0",
    "p-all": "^3.0.0",
    "pg": "8.23.1",
    "prompt": "^1.3.0",
    "sass": "^1.94.0",
    "session-file-store": "^1.5.0",
    "sharp": "^0.35.5",
    "sift": "^17.1.3",
    "stream-to-array": "^2.3.0",
    "strip-ansi": "^7.1.2",
    "table": "^6.8.1",
    "tail": "^2.2.6",
    "tailing-stream": "^0.2.0",
    "through": "^2.3.8",
    "tiny-emitter": "^2.1.0",
    "transliteration": "^2.3.5",
    "vue": "^3.5.24",
    "vue-advanced-cropper": "^2.8.8",
    "vue-cookies": "^1.8.4",
    "vue-draggable-next": "^2.3.0",
    "vue-json-viewer": "^3.0.4",
    "vue-router": "^4.6.3",
    "vue-virtual-scroller": "^3.0.5",
    "vue3-shortkey": "git+https://github.com/Zegfault/vue3-shortkey.git#da8ee7ead0c618de22a227da2274d88c33e29aae",
    "vuetify": "^3.10.9",
    "ws": "^8.18.0"
  },
  "config": {
    "port": 9990
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.5.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "mocha": "^12.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "supertest": "^7.0.0",
    "vite": "^6.4.1",
    "vite-plugin-vuetify": "^2.0.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "excel4node": {
      "image-size": "^2.0.4",
      "uuid": "^11.1.1"
    }
  }
}
